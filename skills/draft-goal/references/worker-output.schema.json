{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-generated-document-fields": {
    "caller_raw_ask_b64": "caller-binding",
    "raw_ask_chars": "caller-framing",
    "char_count": "validation-counts",
    "validated_at": "validation-timestamp",
    "validated_digest": "validation-digest",
    "validator_ruleset": "validation-ruleset",
    "depends_on": "dependency-ids",
    "manifest": "manifest-path"
  },
  "type": "object",
  "required": ["fit_class", "rejection", "questions", "members"],
  "additionalProperties": false,
  "properties": {
    "fit_class": {
      "enum": ["one-shot", "goal", "loop", "goal+loop", "not-autonomous-fit"]
    },
    "rejection": {
      "type": ["object", "null"],
      "required": ["reason", "alternative"],
      "additionalProperties": false,
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "alternative": {"type": "string", "minLength": 1}
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "prompt"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["route", "authority", "fit", "verifier"]},
          "prompt": {"type": "string", "minLength": 1}
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "outcome",
          "depends_on",
          "goal_kind",
          "autonomy",
          "cadence_seconds",
          "budget",
          "raw_ask",
          "context",
          "scope_authority",
          "ground_truth",
          "success",
          "loop_policy",
          "termination",
          "final_report",
          "coverage"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "outcome": {"type": "string", "minLength": 1, "x-condition-section": "GOAL"},
          "depends_on": {
            "x-generated-document-field": "depends_on",
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
          },
          "goal_kind": {"enum": ["goal", "loop", "goal+loop"]},
          "autonomy": {"enum": ["autonomous", "human-gated"]},
          "cadence_seconds": {"type": ["integer", "null"], "minimum": 1},
          "budget": {
            "type": "object",
            "required": ["activations", "no_progress_cycles", "wall_clock"],
            "additionalProperties": false,
            "properties": {
              "activations": {"type": "integer", "minimum": 1},
              "no_progress_cycles": {"type": "integer", "minimum": 1},
              "wall_clock": {"type": ["string", "null"], "minLength": 1}
            }
          },
          "raw_ask": {"type": "string", "minLength": 1, "x-prohibition-role": "source", "x-caller-input": "verbatim"},
          "context": {"type": "string", "minLength": 1, "x-condition-section": "CONTEXT"},
          "scope_authority": {
            "x-condition-section": "SCOPE & AUTHORITY",
            "type": "object",
            "required": [
              "in_scope",
              "exclusions",
              "allowed_actions",
              "human_approval_required_for"
            ],
            "additionalProperties": false,
            "properties": {
              "in_scope": {"type": "string", "minLength": 1},
              "exclusions": {
                "x-prohibition-role": "exclusion",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "allowed_actions": {"type": "string", "minLength": 1},
              "human_approval_required_for": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "ground_truth": {"type": "string", "minLength": 1, "x-condition-section": "GROUND TRUTH"},
          "success": {
            "x-condition-section": "SUCCESS",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "predicate", "verify", "evidence", "authority"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^S[1-9][0-9]*$"},
                "predicate": {"type": "string", "minLength": 1},
                "verify": {"type": "string", "minLength": 1},
                "evidence": {"type": "string", "minLength": 1},
                "authority": {"type": "string", "minLength": 1}
              }
            }
          },
          "loop_policy": {"type": "string", "minLength": 1, "x-condition-section": "LOOP POLICY"},
          "termination": {
            "x-condition-section": "TERMINATION",
            "type": "object",
            "required": ["success", "blocked", "budget_exhausted", "unsafe_or_out_of_scope"],
            "additionalProperties": false,
            "properties": {
              "success": {"type": "string", "minLength": 1},
              "blocked": {"type": "string", "minLength": 1},
              "budget_exhausted": {"type": "string", "minLength": 1},
              "unsafe_or_out_of_scope": {"type": "string", "minLength": 1}
            }
          },
          "final_report": {"type": "string", "minLength": 1, "x-condition-section": "FINAL REPORT"},
          "coverage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["element", "placement"],
              "additionalProperties": false,
              "properties": {
                "element": {"type": "string", "minLength": 1, "x-prohibition-role": "source", "x-caller-input": "projection"},
                "placement": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
