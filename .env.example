# Copy this file to .env and add only local values.
# .env is ignored by Git. Never commit credentials.

# Optional notification integration.
# NTFY_URL=https://notify.example.invalid
# NTFY_TOKEN=

# Optional GitHub integration. Prefer authenticated CLI storage when supported.
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional issue/wiki integration.
# ISSUE_TRACKER_USERNAME=user@example.invalid
# ISSUE_TRACKER_API_TOKEN=
